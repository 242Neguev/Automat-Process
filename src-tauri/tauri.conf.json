{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Automat-Process",
  "version": "0.3.0",
  "identifier": "com.eauseche.automatprocess",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Automat-Process",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "Eau sèche",
    "copyright": "© 2026 Eau sèche",
    "shortDescription": "Documents personnalisés à partir d'un modèle et d'une liste",
    "longDescription": "Automat-Process génère en série cartes de visite, signatures e-mail et documents personnalisés à partir d'un modèle graphique et d'un fichier Excel.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
